{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --runInBand",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=chromium --reporter=line",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "lh:routes": "node scripts/lh-run.cjs",
    "ci:verify": "pnpm lint && pnpm typecheck && pnpm test",
    "img:opt": "tsx scripts/optimize-images.ts",
    "report:types": "node scripts/typefix-report.cjs",
    "test:jest": "jest",
    "audit:site": "scripts/audit.sh",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:secrets:staged": "git diff --cached --name-only --diff-filter=ACM | xargs -I{} -r secretlint \"{}\"",
    "postinstall": "husky || true",
    "audit:quick": "QUICK=1 A11Y=1 LHCI=1 scripts/audit.sh",
    "audit:headers": "A11Y=0 LHCI=0 scripts/audit.sh",
    "audit:no-install": "SKIP_INSTALL=1 scripts/audit.sh",
    "audit:no-build": "SKIP_BUILD=1 scripts/audit.sh",
    "audit:fast": "QUICK=1 SKIP_INSTALL=1 SKIP_BUILD=1 LH_RUNS=1 AXE_CONCURRENCY=6 ROUTES=/,/services scripts/audit.sh",
    "audit:perf-only": "A11Y=0 LHCI=1 LH_CATS=performance LH_RUNS=1 QUICK=1 SKIP_INSTALL=1 SKIP_BUILD=1 scripts/audit.sh",
    "kill-3000": "lsof -ti :3000 | xargs -r kill"
  },
  "dependencies": {
    "@openai/chatkit-react": "^0.0.0",
    "@radix-ui/react-label": "2.1.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.74.0",
    "@vercel/analytics": "1.5.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "embla-carousel": "^8.6.0",
    "jose": "^6.1.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.4",
    "react": "18.3.1",
    "react-calendly": "^4.4.0",
    "react-dom": "18.3.1",
    "resend": "^6.1.2",
    "tailwind-merge": "^2.5.5",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.10",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.4",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^11.0.0",
    "husky": "^9.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.2.10",
    "playwright": "^1.56.1",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.4.2",
    "secretlint": "^11.2.4",
    "sharp": "^0.33.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.15.1",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
