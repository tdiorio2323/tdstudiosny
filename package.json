{
  "name": "my-v0-project",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --max-warnings=0 --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ci": "vitest run --runInBand",
    "e2e": "playwright test",
    "e2e:ci": "playwright test --project=chromium --reporter=line",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "analyze": "ANALYZE=true next build",
    "db:migrate": "supabase db push",
    "db:seed": "supabase db seed",
    "lh:routes": "node scripts/lh-run.cjs",
    "ci:verify": "pnpm lint && pnpm typecheck && pnpm test",
    "img:opt": "tsx scripts/optimize-images.ts",
    "report:types": "node scripts/typefix-report.cjs",
    "test:jest": "jest",
    "audit:site": "scripts/audit.sh",
    "scan:secrets": "secretlint \"**/*\"",
    "scan:secrets:staged": "git diff --cached --name-only --diff-filter=ACM | xargs -I{} -r secretlint \"{}\"",
    "postinstall": "husky || true",
    "audit:quick": "QUICK=1 A11Y=1 LHCI=1 scripts/audit.sh",
    "audit:headers": "A11Y=0 LHCI=0 scripts/audit.sh",
    "audit:no-install": "SKIP_INSTALL=1 scripts/audit.sh",
    "audit:no-build": "SKIP_BUILD=1 scripts/audit.sh",
    "audit:fast": "QUICK=1 SKIP_INSTALL=1 SKIP_BUILD=1 LH_RUNS=1 AXE_CONCURRENCY=6 ROUTES=/,/services scripts/audit.sh",
    "audit:perf-only": "A11Y=0 LHCI=1 LH_CATS=performance LH_RUNS=1 QUICK=1 SKIP_INSTALL=1 SKIP_BUILD=1 scripts/audit.sh",
    "kill-3000": "lsof -ti :3000 | xargs -r kill"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@openai/chatkit-react": "^0.0.0",
    "@radix-ui/react-accordion": "1.2.2",
    "@radix-ui/react-alert-dialog": "1.1.4",
    "@radix-ui/react-aspect-ratio": "1.1.1",
    "@radix-ui/react-avatar": "1.1.2",
    "@radix-ui/react-checkbox": "1.1.3",
    "@radix-ui/react-collapsible": "1.1.2",
    "@radix-ui/react-context-menu": "2.2.4",
    "@radix-ui/react-dialog": "1.1.4",
    "@radix-ui/react-dropdown-menu": "2.1.4",
    "@radix-ui/react-hover-card": "1.1.4",
    "@radix-ui/react-label": "2.1.1",
    "@radix-ui/react-menubar": "1.1.4",
    "@radix-ui/react-navigation-menu": "1.2.3",
    "@radix-ui/react-popover": "1.1.4",
    "@radix-ui/react-progress": "1.1.1",
    "@radix-ui/react-radio-group": "1.2.2",
    "@radix-ui/react-scroll-area": "1.2.2",
    "@radix-ui/react-select": "2.1.4",
    "@radix-ui/react-separator": "1.1.1",
    "@radix-ui/react-slider": "1.2.2",
    "@radix-ui/react-slot": "1.1.1",
    "@radix-ui/react-switch": "1.1.2",
    "@radix-ui/react-tabs": "1.1.2",
    "@radix-ui/react-toast": "1.2.4",
    "@radix-ui/react-toggle": "1.1.1",
    "@radix-ui/react-toggle-group": "1.1.1",
    "@radix-ui/react-tooltip": "1.1.6",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.74.0",
    "@vercel/analytics": "1.5.0",
    "autoprefixer": "^10.4.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.4",
    "date-fns": "4.1.0",
    "embla-carousel": "^8.6.0",
    "embla-carousel-react": "8.5.1",
    "geist": "latest",
    "input-otp": "1.4.1",
    "jose": "^6.1.0",
    "lucide-react": "^0.454.0",
    "next": "15.5.4",
    "next-themes": "latest",
    "openai": "^6.2.0",
    "react": "18.3.1",
    "react-calendly": "^4.4.0",
    "react-day-picker": "9.8.0",
    "react-dom": "18.3.1",
    "react-hook-form": "^7.60.0",
    "react-resizable-panels": "^2.1.7",
    "recharts": "2.15.4",
    "resend": "^6.1.2",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "vaul": "^0.9.9",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@secretlint/secretlint-rule-preset-recommend": "^11.2.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.18.10",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.19.1",
    "@typescript-eslint/parser": "^8.19.1",
    "depcheck": "^1.4.7",
    "dotenv": "^17.2.3",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.4",
    "eslint-config-prettier": "^9.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.2",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^11.0.0",
    "husky": "^9.1.6",
    "jest": "^30.2.0",
    "jest-environment-jsdom": "^30.2.0",
    "jsdom": "^27.1.0",
    "knip": "^5.67.1",
    "lighthouse": "^12.8.2",
    "lint-staged": "^15.2.10",
    "playwright": "^1.56.1",
    "postcss": "^8.5",
    "postcss-load-config": "^6.0.1",
    "prettier": "^3.4.2",
    "secretlint": "^11.2.4",
    "sharp": "^0.33.5",
    "start-server-and-test": "^2.1.2",
    "tailwindcss": "^3.4.17",
    "ts-prune": "^0.10.3",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "packageManager": "pnpm@10.15.1",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --max-warnings=0 --fix"
    ],
    "*.{ts,tsx,js,jsx,json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
